{
  "provider": {
    "default": "claude",
    "commands": {
      "claude":  ["claude", "--print"],
      "codex":   ["codex"],
      "copilot": ["gh", "copilot", "suggest", "-t", "shell"]
    }
  },
  "gc": {
    "enabled": true,
    "historyTokenLimit": 12000,
    "targetSummaryTokens": 500,
    "preserveErrors": true,
    "preserveDecisions": true,
    "preserveCodeChanges": true
  },
  "tokens": {
    "provider": "openai",
    "model": "gpt-4.1",
    "hardLimit": 100000,
    "warningLimit": 50000,
    "requireConfirmationAbove": 75000
  }
}
