{
  "provider": {
    "default": "local-llm",
    "commands": {
      "local-llm": ["your-llm-cli"]
    }
  },
  "gc": {
    "enabled": true,
    "command": ["your-llm-cli"],
    "historyTokenLimit": 12000,
    "targetSummaryTokens": 500,
    "preserveErrors": true,
    "preserveDecisions": true,
    "preserveCodeChanges": true
  },
  "tokens": {
    "provider": "generic",
    "model": "default",
    "hardLimit": 100000,
    "warningLimit": 50000,
    "requireConfirmationAbove": 75000
  }
}
