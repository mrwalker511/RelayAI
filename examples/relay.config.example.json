{
  "provider": {
    "default": "codex",
    "commands": {
      "codex": ["codex", "exec", "-"],
      "copilot": ["copilot", "-p", "{prompt}"]
    }
  },
  "routing": {},
  "gc": {
    "enabled": true,
    "command": ["codex", "exec", "-"],
    "historyTokenLimit": 12000,
    "targetSummaryTokens": 500,
    "preserveErrors": true,
    "preserveDecisions": true,
    "preserveCodeChanges": true
  },
  "tokens": {
    "provider": "openai",
    "model": "gpt-5-codex",
    "hardLimit": 100000,
    "warningLimit": 50000,
    "requireConfirmationAbove": 75000
  },
  "files": {
    "maxIndex": 200
  },
  "context": {
    "hierarchical": false,
    "contextDir": ".relay/context",
    "maxBranches": 3
  },
  "filter": {
    "enabled": true,
    "maxLines": 300,
    "maxSuccessOccurrences": 3,
    "dedupConsecutive": true,
    "collapseBlankLines": true
  }
}
