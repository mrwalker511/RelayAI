{
  "name": "relay-cli-monorepo",
  "private": true,
  "version": "0.1.1",
  "license": "MIT",
  "description": "Local-first context and prompt-cache optimizer for coding CLIs.",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r build",
    "ci": "pnpm build && pnpm typecheck && pnpm test && pnpm pack:check",
    "dev": "pnpm --filter @relay-cache/cli dev",
    "lint": "pnpm -r lint",
    "pack:check": "pnpm clean && pnpm build && npm pack --dry-run --cache /tmp/npm-cache ./packages/core && npm pack --dry-run --cache /tmp/npm-cache ./packages/cli",
    "compare": "tsx scripts/compare.ts",
    "coverage": "pnpm build && pnpm -r coverage",
    "docs": "tsx scripts/gen-docs.ts",
    "sigmap": "tsx scripts/gen-sigmap.ts",
    "pretest": "pnpm build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "clean": "rm -rf packages/*/dist",
    "bench": "tsx scripts/bench.ts"
  },
  "pnpm": {
    "overrides": {
      "hono": ">=4.12.25"
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "marked": "^18.0.11",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "typescript5": "npm:typescript@^5.9.3"
  }
}
