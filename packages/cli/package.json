{
  "name": "@relay/cli",
  "version": "0.1.0",
  "description": "Local-first context and prompt-cache optimizer for coding agents and model CLIs.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "relay": "dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "relay",
    "llm",
    "prompt",
    "cache",
    "context",
    "claude",
    "codex",
    "copilot",
    "ai",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mrwalker511/RelayAI.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/mrwalker511/RelayAI#readme",
  "bugs": {
    "url": "https://github.com/mrwalker511/RelayAI/issues"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@relay/core": "workspace:*",
    "commander": "^15.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
