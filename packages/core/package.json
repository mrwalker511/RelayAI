{
  "name": "@relay-cache/core",
  "version": "0.1.1",
  "description": "Core context engine for the Relay prompt-cache optimizer.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "relay",
    "llm",
    "prompt",
    "cache",
    "context",
    "tokenizer",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mrwalker511/RelayAI.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/mrwalker511/RelayAI#readme",
  "bugs": {
    "url": "https://github.com/mrwalker511/RelayAI/issues"
  },
  "license": "MIT",
  "author": "RelayAI Contributors",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "coverage": "node --experimental-test-coverage --test dist/*.test.js dist/*/*.test.js",
    "test": "node --test dist/*.test.js dist/*/*.test.js"
  },
  "dependencies": {
    "fast-glob": "^3.3.2",
    "js-tiktoken": "^1.0.15",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
